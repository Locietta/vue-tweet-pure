{
  "repository": "https://github.com/Locietta/vue-tweet-pure",
  "license": "MIT",
  "private": true,
  "author": "Locietta <locietta@qq.com>",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && pnpm publish -r",
    "release-ci": "turbo run build && pnpm publish -r --no-git-checks",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.7.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5"
  }
}

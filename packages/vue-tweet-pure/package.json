{
  "name": "vue-tweet-pure",
  "version": "0.3.0",
  "repository": "https://github.com/Locietta/vue-tweet-pure",
  "bugs": {
    "url": "https://github.com/Locietta/vue-tweet-pure/issues"
  },
  "author": "Locietta <locietta@qq.com>",
  "license": "MIT",
  "description": "A Vue 3 component for embedding tweets in your Vue.js applications.",
  "keywords": [
    "vue",
    "vue3",
    "tweet",
    "twitter",
    "embed",
    "vue-tweet"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-tweet-pure.cjs.js",
  "module": "./dist/vue-tweet-pure.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-tweet-pure.es.js",
      "require": "./dist/vue-tweet-pure.cjs.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api.es.js",
      "require": "./dist/api.cjs.js"
    },
    "./style.css": "./dist/vue-tweet-pure.css"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint --cache --fix ./src/**/*.{ts,vue}",
    "build": "vite build && pnpm build:types",
    "build:types": "vue-tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "lightningcss": "^1.33.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": ">= 3.3.0"
  }
}
